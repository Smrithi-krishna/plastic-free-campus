# Leave unset to use SQLite (no setup needed).
# For MySQL, create the database first:  CREATE DATABASE plastic_free_campus;
DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/plastic_free_campus

# Secret used to sign login tokens. Use a long random string in production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# How long a login lasts
TOKEN_HOURS=12

# Creates the first admin on startup if no admin exists (skip if you ran seed.py)
ADMIN_ROLL_NO=ADMIN-01
ADMIN_PASSWORD=change-this-password

# Comma-separated frontend URLs allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://smrithi-krishna.github.io
